        "packages/core/test/notion-mcp-search.test.ts"
      ],
      "scope": "Exact Skills/Files data-source membership, one complete File owner, unique stable claims including disabled rows, retained negative claim, ready owner and enabled ready Source revision. Main-source eligibility applies even to a native supporting match. Final owner/File/Source rereads guard late accepted changes."
    },
    {
      "name": "bounded_remote_semantics",
      "files": [
        "packages/core/src/notion-mcp-client.ts",
        "packages/core/test/notion-mcp-client.test.ts",
        "packages/cli/src/sdk.ts",
        "packages/cli/src/commands-content.ts"
      ],
      "scope": "Only observed workspace_search results, bounded physical Notion IDs and safe URLs, strict protocol/schema and request/byte/deadline budgets. No generic MCP dispatch, body/resource acquisition, fabricated continuation cursor, exact-byte claim or exhaustive absence conclusion."
    },
    {
      "name": "public_sdk_boundary_regression",
      "files": [
        "packages/core/test/sdk-mcp-search.node.test.ts",
        "packages/cli/src/sdk.ts",
        "packages/cli/src/operation-runtime.ts"
      ],
      "scope": "Real loopback REST and MCP services, independent private credential store, preflight dispatch ordering, no explicit-token fallback, wrong workspace/entry suppression, positive/empty responses, revoked/replaced grants during query/401 refresh, cancellation and deadline propagation. No product function is mocked."
    }
  ],
  "unmodeled_bindings": [
    {
      "kind": "host_owned_inputs",
