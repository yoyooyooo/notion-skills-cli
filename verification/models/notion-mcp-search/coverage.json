  "models": {
    "SearchAdmission": {
      "kind": "bounded_remote_discovery_admission",
      "source_model": "AH-1268 design SearchAdmission/v4",
      "symbols": [
        "contentSearch",
        "contentSearchSource",
        "assertContentSearchSource",
        "admitContentSearchMatches",
        "querySelectedSkillMetadataWithClaims",
        "searchNotionMcp"
      ],
      "bounds": "One query; native/projection/owned_file/foreign_source/disabled_skill/unmapped_file/wrong_workspace/ai_search/empty responses; four epoch owners; at most one external change; two ticks.",
      "assumptions": "Weak fairness of local preflight, clock ticks and timeout. No network success or remote completeness assumption. A source epoch means newly accepted evidence, not instantaneous knowledge of external Notion changes.",
      "scope": "Discovery admission and current publication across positive, empty and failure outcomes. CLI owns source/grant/deadline fences; Broker owns session and metadata qualification. These source hashes establish only the local reviewed portion of a cross-repository contract."
    }
  },
  "implementation_bindings": [
    {
      "name": "fresh_source_and_connection",
      "files": [
        "packages/cli/src/sdk.ts",
        "packages/cli/src/operation-runtime.ts",
        "packages/core/src/notion-mcp-search.ts"
      ],
      "scope": "REST resolves before authorization. Source scope and descriptor are reread after authorization and at publication. The MCP user/workspace is verified and the exact selected entry fetched before query. An OAuth refresh cannot switch connection or grant epoch for the old request."
    },
    {
      "name": "physical_admission",
      "files": [
        "packages/core/src/notion-mcp-search.ts",
