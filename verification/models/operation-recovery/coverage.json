  "models": {
    "AcknowledgedRecordPrefix": {
      "kind": "implemented_original_ack_prefix_abstraction",
      "symbols": [
        "acknowledgedNativeRecoveryPrefix",
        "observeNativeMainRecovery",
        "sharedCreateDispatch",
        "guardedSourceMutation",
        "applySharedCreateNativeRecovery"
      ],
      "scope": "Two finite immutable Record positions retain one original ACK prefix and one never-dispatched suffix. The malformed retained set {2} witnesses a prefix hole. Distinguishes original frozen request and payload, durable ACK, exact GET, query/census visibility, intent persistence, dispatch, provider application, ACK persistence, verification, stale premise and permission stops. Current matching facts do not fabricate missing original ACKs.",
      "excluded": [
        "Cross-machine exactly-once",
        "All eight native recovery Records or arbitrary prefix lengths",
        "Credential rotation implementation and real Notion permission propagation",
        "Atomic GET-plus-write or provider CAS",
        "Provider eventual visibility and unconditional liveness"
      ]
    },
    "IndependentAcceptance": {
      "kind": "implemented_independent_acceptance_abstraction",
      "symbols": [
        "reviewSharedFileAddAcceptance",
        "validateReview",
        "applySharedFileAddAcceptance",
        "completedSharedFileAddAcceptance",
        "reconcileSharedFileAddAcceptance",
        "sharedCreateDispatch"
      ],
      "scope": "One failed original add and one independent acceptance identity with frozen File/owner/frontier. The existing configuration family covers exact-candidate acceptance (three ordered Records, five cold proof classes) and explicit observed-body acceptance (four ordered Records including the selected body, six cold proof classes). Every dispatch stays bound to the same reviewed context, unknown writes are not repeated, and neither mode confirms the original failed write.",
      "excluded": [
        "Whole File lifecycle",
        "Arbitrary native byte representation and codec limits",
        "Distributed acceptance writers",
        "Automatic acceptance or repair of unknown original creates",
        "Cold history proof does not assert current body remains unchanged",
        "Actual approval flag, observed byte hash and lossless plan storage are implementation regressions, not state-model guarantees"
      ]
    },
    "RestoreFeedback": {
      "kind": "implemented_business_restore_feedback_abstraction",
      "symbols": [
        "submitSharedFileRequest",
        "assertRequestRestorePlan",
        "writeFeedback",
        "processSharedFileRequest",
        "restoreSelectedSharedFile",
        "reconcileSelectedSharedFileRestore"
      ],
      "scope": "One frozen submitted request, one exact original restore identity, verified processing binding, one body dispatch and one final business feedback dispatch. Body outcome, current equality, feedback application, durable metadata ACK and current eligibility remain separate. Reconcile after body completion only advances undispatched feedback; pending and unknown cannot be replaced by a new submit.",
      "excluded": [
        "HTTP RequestEngine retries and Broker process state",
        "Whole business workflow or arbitrary notification retries",
        "Original processing metadata PATCH transport internals (modeled at retained ACK and exact readback boundary)",
        "Provider CAS or exclusion of edits between the final observation and dispatch",
        "Unconditional progress while results remain unknown"
      ]
    },
    "MaintenanceApply": {
      "kind": "bounded_original_parent_and_verified_child_prefix",
      "symbols": [
        "loadSharedApplyReferenceTree",
        "authenticateApplyParent",
        "executeSharedSkillApply",
        "resumeSharedSkillApply",
        "reconcileSharedSkillApply",
        "loadPendingSharedSkillApplies"
      ],
      "scope": "Three ordered children; original dispatch, received response, retained verified outcome and parent progress remain distinct. Current pending tree is not published. Original local authority is required for an unsent suffix. No CAS, atomic multi-page write or eventual-progress claim.",
      "excluded": [
        "Every native POST/PATCH/Record subrequest; narrower recovery models apply only to their named protocols",
        "Same-execution lifecycle-event ACK/query union, provider index visibility and per-Record crash persistence",
        "Known versus unknown native file modes, exact byte reconstruction and dry-run preview validation",
        "Notion atomic transactions or revision compare-and-swap",
        "An edit after a completed pre-dispatch observation; real readback and failure tests remain required",
        "Raw Markdown/bytes, resource formats, reference rewrite parsing and permissions",
        "Arbitrary plan length, all provider scopes and subsequent legitimate author changes after completion"
      ]
    }
  },
