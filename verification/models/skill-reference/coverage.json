      "files": ["packages/core/src/skill-ref.ts", "packages/core/test/skill-ref.test.ts"],
      "scope": "Explicit Library wins over an ambient context; a short reference without context fails. The shared parser and complete key prevent a title/alias string from becoming a second identity namespace. The finite model abstracts parser bytes."
    },
    {
      "name": "exact_stable_claim",
