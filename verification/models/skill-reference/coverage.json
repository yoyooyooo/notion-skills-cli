  "models": {
    "ReferenceSelection": {
      "bounds": "Two Libraries, two existing stable Skill IDs plus a missing-ID distractor, six fixed selections, three paths, fourteen input scenarios, at most one ambient-default and one live-entrypoint change.",
      "assumptions": "Local binding and selection actions eventually return. The immutable manifest and exact Source evidence are boundary facts; the model does not prove parsing, access, acquisition or byte integrity.",
      "scope": "A short reference binds from its containing Library or explicit tool-entry context. Fixed selection cannot change owner, manifest or selected path. Source-relative lookup requires reliable provenance; ordinary resolution does not write."
    },
    "ImportRelations": {
      "bounds": "One explicitly selected Library, a production distractor, two batch objects, nine input scenarios, one original create per object and a deliberate-replay counterexample, one manual Members edit and one repeat.",
      "assumptions": "Each create outcome is known success, accepted-with-response-lost, or unobserved. Explicit resume eventually observes or blocks; absence never authorizes replay. Initial exact candidate admission is a boundary fact, not natural-language intent.",
      "scope": "Frozen mappings and tri-state relationship inputs; two-phase object/relationship application; preserved Requires and authored Members; unknown outcome recovery. It does not prove whole-tree writes or Notion transactions."
    }
  },
  "implementation_bindings": [
