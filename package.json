{
  "name": "notion-skills-cli-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun run packages/cli/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/test.ts",
    "test:unit": "bun test --timeout 30000 --path-ignore-patterns='**/*.node.test.ts'",
    "test:node": "node node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run typecheck && bun run format:check && bun run test && bun run build",
    "package:check": "bun scripts/package-check.ts",
    "release": "bun scripts/release.ts",
    "release:precheck": "bun scripts/release.ts --precheck"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@effect/vitest": "4.0.5",
    "@biomejs/biome": "2.5.15",
    "effect": "4.0.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "license": "MIT"
}
